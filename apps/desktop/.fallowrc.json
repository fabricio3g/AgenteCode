{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "main/index.ts",
    "main/tts-worker.ts",
    "renderer/src/main.ts",
    "shared/agente-protocol.gen.ts",
    "scripts/roleplay-smoke-entry.ts",
    "main/chat-db-worker.ts",
    "extension/src/background.ts",
    "extension/src/page.ts",
    "extension/src/console-hook.ts",
    "extension/src/panel/panel.ts",
    "scripts/audit-ui-components.mjs",
    "scripts/smoke-document-ingestion.ts",
    "scripts/smoke-local-model.mjs",
    "scripts/verify-package.cjs",
    "scripts/packaging.cjs",
    "extension/src/panel/panel.css"
  ],
  "ignorePatterns": [
    "dist/**",
    "dist-electron/**",
    "build/**",
    "out/**",
    "web-browser/**",
    "renderer/dist/**",
    "renderer/patches/**",
    "renderer/src/lib/wasm/**",
    "renderer/public/tts-worker.cjs",
    "preload/preload.cjs",
    "renderer/svelte.config.js",
    "renderer/src/**/test-fixtures/**"
  ],
  "ignoreDependencies": [
    "@lancedb/lancedb-win32-x64-msvc",
    "sherpa-onnx-win-x64",
    "ffprobe-static",
    "agente:snapshot"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "error",
    "unused-class-members": "off",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error"
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 40,
    "minLines": 5
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30
  }
}

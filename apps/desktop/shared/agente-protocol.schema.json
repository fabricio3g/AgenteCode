    },
    "Trust": {
      "description": "How much a turn's origin is trusted. A turn can never do more than its least-trusted origin allows; handoffs between bots keep the lowest level.",
      "oneOf": [
        {
          "description": "Anyone in a public room: answers only, no tools that change anything.",
          "enum": [
            "public"
          ],
          "type": "string"
        },
        {
          "description": "An allow-listed person: chat, search and artifacts, no shell or files.",
          "enum": [
            "trusted"
          ],
          "type": "string"
        },
        {
          "description": "The person who runs this Agente.",
          "enum": [
            "owner"
          ],
          "type": "string"
        }
      ]
    },
    "TurnMode": {
      "description": "Plan (read-only) or build (can change files and run commands).",
      "enum": [
        "plan",
        "build"
      ],
      "type": "string"
    },
    "TurnOutcome": {
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/TurnStatus"
        },
        "tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "turn_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "session_id",
        "status",
        "tokens",
        "turn_id"
      ],
      "type": "object"
    },
    "TurnStatus": {
      "enum": [
        "completed",
        "cancelled",
        "failed"
      ],
      "type": "string"
    },
    "Usage": {
      "properties": {
        "cache_creation_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "cache_read_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "completion_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "context_tokens": {
          "default": 0,
          "description": "Full prompt size of the last request (uncached + cache read + cache write): the context in use. 0 when unreported.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "prompt_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cache_creation_tokens",
        "cache_read_tokens",
        "completion_tokens",
        "prompt_tokens"
      ],
      "type": "object"
    },
    "UserInput": {
      "properties": {
        "content": {
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    }
  },
  "description": "Agente runtime protocol v2",
  "title": "AgenteProtocol"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ApprovalDecision": {
      "properties": {
        "decision": {
          "$ref": "#/definitions/ApprovalDecisionKind"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "decision",
        "request_id"
      ],
      "type": "object"
    },
    "ApprovalDecisionKind": {
      "enum": [
        "approve_once",
        "approve_all",
        "deny",
        "cancel"
      ],
      "type": "string"
    },
    "Attachment": {
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/definitions/AttachmentKind"
        },
        "mime": {
          "description": "MIME type (`image/png`, `audio/mpeg`, `video/mp4`, `application/pdf`).",
          "type": "string"
        },
        "name": {
          "description": "Original file name, for display.",
          "type": "string"
        },
        "path": {
          "description": "Absolute path of the stored copy.",
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "kind",
        "mime",
        "name",
        "path"
      ],
      "type": "object"
    },
    "AttachmentKind": {
      "description": "What kind of media an attachment is, which decides how each provider format carries it and which models accept it.",
      "enum": [
        "image",
        "audio",
        "video",
        "pdf"
      ],
      "type": "string"
    },
    "ChildSnapshot": {
      "properties": {
        "run_id": {
          "format": "uuid",
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "run_id",
        "status"
      ],
      "type": "object"
    },
    "FunctionCall": {
      "properties": {
        "arguments": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "arguments",
        "name"
      ],
      "type": "object"
    },
    "Message": {
      "properties": {
        "attachments": {
          "description": "Media sent with a user message (images, audio, video, PDFs). Each is a stored copy on disk; providers encode it at request time, so saved sessions carry references, not bytes.",
          "items": {
            "$ref": "#/definitions/Attachment"
          },
          "type": "array"
        },
        "content": {
          "type": "string"
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProviderContinuation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ordered provider-native blocks needed for lossless tool/reasoning replay."
        },
        "role": {
          "$ref": "#/definitions/Role"
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking_signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_calls": {
          "items": {
            "$ref": "#/definitions/ToolCall"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "content",
        "role"
      ],
      "type": "object"
    },
    "Origin": {
      "description": "Where a turn came from: a client (tui, desktop, web) or a bot channel.",
      "properties": {
        "channel": {
          "type": "string"
        },
        "sender": {
          "type": [
            "string",
            "null"
          ]
        },
        "trust": {
          "$ref": "#/definitions/Trust",
          "default": "owner"
        }
      },
      "required": [
        "channel"
      ],
      "type": "object"
    },
    "ProviderContinuation": {
      "properties": {
        "blocks": {
          "items": true,
          "type": "array"
        },
        "model_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        }
      },
      "required": [
        "blocks",
        "model_id",
        "provider_id"
      ],
      "type": "object"
    },
    "Role": {
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "type": "string"
    },

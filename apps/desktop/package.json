{
  "name": "agente-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Agente Desktop – local AI workspace (Electron)",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabricio3g/AgenteCode.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "postinstall": "patch-package && (npm run rebuild:native || exit 0)",
    "rebuild:native": "electron-rebuild -f -w sherpa-onnx-node -w node-pty",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && npx vite --port 5173",
    "dev:main": "npm run build:main:watch",
    "build:main:watch": "node scripts/build-bundles.mjs main --watch",
    "dev:agente": "cargo build --bin agente --bin agente-computer --manifest-path ../../Cargo.toml",
    "dev:electron": "npm run dev:agente && wait-on http://localhost:5173 dist-electron/main/index.cjs && node scripts/dev-electron.mjs --no-sandbox",
    "prebuild": "npm run rebuild:native && npm run build:agente",
    "build:main": "node scripts/build-bundles.mjs main --minify",
    "build:icons": "node scripts/build-icons.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:renderer": "cd renderer && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "fetch:native-runtimes": "node scripts/fetch-native-runtimes.mjs",
    "build:agente": "cargo build --release --bin agente --bin agente-computer --manifest-path ../../Cargo.toml && node scripts/bundle-agente.mjs",
    "build": "npm run build:main && npm run build:renderer && electron-builder",
    "start": "npx electron .",
    "gen:protocol": "node scripts/gen-protocol-types.mjs",
    "check": "cd renderer && npx svelte-check --tsconfig ./tsconfig.json",
    "onboarding:reset": "node scripts/reset-onboarding.mjs",
    "fallow:summary": "npx fallow --summary",
    "fallow:dead-code": "npx fallow dead-code",
    "fallow:dupes": "npx fallow dupes",
    "fallow:health": "npx fallow health",
    "fallow:audit": "npx fallow audit --base main --dead-code-baseline fallow-baselines/dead-code.json --health-baseline fallow-baselines/health.json --dupes-baseline fallow-baselines/dupes.json",
    "fallow:fix:dry-run": "npx fallow fix --dry-run",
    "test:crawler": "node --test tests/crawler/*.test.js",
    "test:scraper": "npx tsx --test tests/unit/web-scraper.test.js",
    "smoke:search": "npx tsx scripts/smoke-search-scrape.mjs",
    "smoke:deepseek": "npx tsx scripts/smoke-deepseek-flash.mjs",
    "smoke:roleplay": "node scripts/smoke-roleplay.mjs",
    "smoke:doc": "npx tsx scripts/smoke-doc-scrape.mjs",
    "smoke:live-data": "node scripts/smoke-live-data.mjs",
    "smoke:models": "npx tsx scripts/smoke-provider-models.mjs",
    "bench:agent": "node scripts/bench-agent-stability.mjs",
    "bench:runtime": "tsx scripts/bench-runtime.ts",
    "probe:sqlite": "npx electron scripts/probe-sqlite-electron.cjs",
    "test": "npx tsx --test tests/**/*.test.js",
    "build:cities": "node scripts/build-cities.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "report:package": "node scripts/package-report.mjs",
    "audit:ui": "node scripts/audit-ui-components.mjs"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@mozilla/readability": "^0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apache-arrow": "^18.1.0",
    "diff": "^9.0.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "ical.js": "2.2.1",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "mammoth": "^1.8.0",
    "marked": "^16.4.2",
    "node-pty": "^1.1.0",
    "openai": "^6.49.0",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^3.12.0",
    "sharp": "0.35.5",
    "svelte-i18n": "^4.0.1",
    "tar": "^7.5.13",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-win32-x64-msvc": "^0.27.2",
    "puppeteer": "^23.0.0",
    "sherpa-onnx-node": "^1.12.40",
    "sherpa-onnx-win-x64": "1.12.29"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "^2.1.1",
    "@electron/rebuild": "^4.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "all-the-cities": "^3.1.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.7",
    "fallow": "^2.64.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "dev.agente.desktop",
    "productName": "Agente",
    "icon": "renderer/public/app-icon.png",
    "publish": {
      "provider": "github",
      "owner": "fabricio3g",
      "repo": "AgenteCode"
    },
    "artifactName": "AgenteDesktop-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/main/**/*",
      "preload/**/*",
      "renderer/dist/**/*",
      "!**/*.map",
      "!dist-electron/main/meta.json"
    ],
    "asarUnpack": [
      "node_modules/apache-arrow/**/*",
      "node_modules/@lancedb/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!llama/**/*",
          "!whisper/**/*",
          "!audio/cpu/**/*"
        ]
      }
    ],
    "linux": {
      "maintainer": "Fabricio Medrano <48396639+fabricio3g@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education"
    },
    "win": {
      "icon": "build/app-icon-dev.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "AgenteDesktop-windows-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "appImage": {
      "artifactName": "AgenteDesktop-linux-x64.AppImage"
    },
    "deb": {
      "artifactName": "AgenteDesktop-linux-${arch}.deb",
      "afterInstall": "scripts/deb-after-install.sh"
    },
    "beforePack": "scripts/packaging.cjs",
    "afterPack": "scripts/verify-package.cjs"
  }
}

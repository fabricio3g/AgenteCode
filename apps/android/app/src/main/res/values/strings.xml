<resources>
    <string name="app_name" translatable="false">Agente</string>

    <!--
      The phone's own moments: wording the desktop has no equivalent for, so it
      cannot come from the generated `copy.xml` (which carries all seven
      languages). These are English until the desktop grows a matching string,
      which is why they are marked untranslatable rather than silently falling
      back — see apps/android/README.md.
    -->

    <!-- Sharing to another Android app is a platform affordance, not a desktop one. -->
    <string name="action_share" translatable="false">Share</string>

    <!-- The Code space is honest about being unconnected until pairing ships. -->
    <string name="code_title" translatable="false">Your desktop, within reach.</string>
    <string name="code_headline" translatable="false">No computer connected</string>
    <string name="code_body" translatable="false">Pairing a computer arrives with the desktop connection. Home and Roleplay already run on this device.</string>

    <!-- Credentials and sync: this device is the whole story for now. -->
    <string name="vault_note" translatable="false">Your key stays on this device and is sent only to the provider you choose.</string>
    <string name="sync_note_local" translatable="false">Saved on this device. Desktop sync is not connected yet.</string>

    <!-- Failures the native bridge can raise with no desktop counterpart. -->
    <string name="character_save_failed" translatable="false">Could not save the character.</string>
    <string name="models_failed" translatable="false">Could not load this provider\'s models.</string>
    <string name="settings_save_failed" translatable="false">Could not save these settings.</string>
    <string name="reply_interrupted" translatable="false">The reply stopped early. You can send another message.</string>
    <string name="reply_running" translatable="false">A reply is already running. Finish or stop it first.</string>

    <plurals name="sync_note_pending" translatable="false">
        <item quantity="one">%1$d change waiting to sync. Desktop sync is not connected yet.</item>
        <item quantity="other">%1$d changes waiting to sync. Desktop sync is not connected yet.</item>
    </plurals>
</resources>

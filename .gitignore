# Rust build artifacts (workspace root *and* any per-crate target/ a stray
# `cargo` invocation leaves behind)
target/
**/*.rs.bk
Cargo.lock.orig

# Local live config — `agente.json.example` is the canonical committed template.
agente.json

# Sessions & scratch
.agente/
.agente_memory.json
*.ndjson
*.log
test-minimax.sh

# Local agent plans & design scratch (machine-generated, not source)
.zcode/
design-plans/

# Local structural index (generated by `codegraph init`)
.codegraph/

# Trailer project: local, self-contained renders and assets, never source
trailer/

# Node native module artifacts
*.node
node_modules/

# Editor/OS junk
.DS_Store
Thumbs.db

# Local-only tool state (machine-specific, never source)
.claude/

# Prebuilt napi artifact (regenerated by build.rs)
crates/agente-node/index.node

# Python bytecode
__pycache__/
*.pyc

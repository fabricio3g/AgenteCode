{
  "name": "talamolm-electron",
  "version": "0.1.0",
  "private": true,
  "description": "TalamoLM – AI Chat Assistant (Electron)",
  "type": "module",
  "main": "main/index.js",
  "scripts": {
    "postinstall": "@electron/rebuild -f -w better-sqlite3 || exit 0",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && npx vite --port 5173",
    "dev:electron": "wait-on http://localhost:5173 && electron . --no-sandbox",
    "build:renderer": "cd renderer && npx vite build",
    "build": "npm run build:renderer && electron-builder",
    "start": "electron . --no-sandbox",
    "check": "cd renderer && npx svelte-check --tsconfig ./tsconfig.json",
    "onboarding:reset": "node scripts/reset-onboarding.mjs",
    "test:crawler": "node --test tests/crawler/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@google/generative-ai": "^0.24.1",
    "@lancedb/lancedb": "^0.27.2",
    "@mistralai/mistralai": "^2.2.1",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/sdk": "^0.12.21",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^11.10.0",
    "electron-store": "^10.0.0",
    "extract-zip": "^2.0.1",
    "groq-sdk": "^1.1.2",
    "linkedom": "^0.18.12",
    "lucide-svelte": "^1.0.1",
    "mammoth": "^1.8.0",
    "openai": "^6.34.0",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^3.12.0",
    "svelte-i18n": "^4.0.1",
    "tar": "^7.5.13"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-win32-x64-msvc": "^0.27.2",
    "puppeteer": "^23.0.0",
    "sherpa-onnx-node": "^1.10.30"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "concurrently": "^9.1.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.talamolm.electron",
    "productName": "TalamoLM",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/apache-arrow/**/*",
      "node_modules/@lancedb/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "../models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    }
  }
}

{
  "name": "chatealm",
  "version": "0.1.0",
  "private": true,
  "description": "Chatea LM – AI Chat Assistant (Electron)",
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "postinstall": "npm run rebuild:native || exit 0",
    "rebuild:native": "@electron/rebuild -f -w better-sqlite3 -w sherpa-onnx-node",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && npx vite --port 5173",
    "dev:main": "npx esbuild main/index.ts --bundle --outfile=dist-electron/main/index.cjs --platform=node --format=cjs --external:electron --external:better-sqlite3 --external:@lancedb/* --external:apache-arrow --external:sherpa-onnx-node --external:kokoro-js --external:@huggingface/transformers --external:onnxruntime-node --watch & npx esbuild main/tts-worker.ts --bundle --outfile=dist-electron/main/tts-worker.cjs --platform=node --format=cjs --external:kokoro-js --external:@huggingface/transformers --external:onnxruntime-node --watch",
    "dev:electron": "wait-on http://localhost:5173 dist-electron/main/index.cjs && npx electron . --no-sandbox",
    "prebuild": "npm run rebuild:native",
    "build:main": "npx esbuild main/index.ts --bundle --outfile=dist-electron/main/index.cjs --platform=node --format=cjs --external:electron --external:better-sqlite3 --external:@lancedb/* --external:apache-arrow --external:sherpa-onnx-node --external:kokoro-js --external:@huggingface/transformers --external:onnxruntime-node --minify",
    "build:renderer": "cd renderer && npx vite build",
    "build": "npm run build:main && npm run build:renderer && electron-builder",
    "start": "npx electron . --no-sandbox",
    "check": "cd renderer && npx svelte-check --tsconfig ./tsconfig.json",
    "onboarding:reset": "node scripts/reset-onboarding.mjs",
    "fallow:summary": "npx fallow --summary",
    "fallow:dead-code": "npx fallow dead-code",
    "fallow:dupes": "npx fallow dupes",
    "fallow:health": "npx fallow health",
    "fallow:audit": "npx fallow audit --base main --dead-code-baseline fallow-baselines/dead-code.json --health-baseline fallow-baselines/health.json --dupes-baseline fallow-baselines/dupes.json",
    "fallow:fix:dry-run": "npx fallow fix --dry-run",
    "test:crawler": "node --test tests/crawler/*.test.js",
    "test": "npx tsx --test tests/**/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@google/generative-ai": "^0.24.1",
    "@lancedb/lancedb": "^0.27.2",
    "@mistralai/mistralai": "^2.2.1",
    "@mozilla/readability": "^0.6.0",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^12.9.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "extract-zip": "^2.0.1",
    "groq-sdk": "^1.1.2",
    "kokoro-js": "^1.2.1",
    "linkedom": "^0.18.12",
    "lucide-svelte": "^1.0.1",
    "mammoth": "^1.8.0",
    "openai": "^6.34.0",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^3.12.0",
    "svelte-i18n": "^4.0.1",
    "tar": "^7.5.13"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-win32-x64-msvc": "^0.27.2",
    "puppeteer": "^23.0.0",
    "sherpa-onnx-node": "^1.12.40",
    "sherpa-onnx-win-x64": "1.12.29"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.1",
    "@electron/rebuild": "^4.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^25.1.8",
    "fallow": "^2.64.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.chatea.lm",
    "productName": "Chatea LM",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/apache-arrow/**/*",
      "node_modules/@lancedb/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "../models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    }
  }
}

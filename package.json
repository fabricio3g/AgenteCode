{
  "name": "talamolm-electron",
  "version": "0.1.0",
  "private": true,
  "description": "TalamoLM – AI Chat Assistant (Electron)",
  "type": "module",
  "main": "main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && npx vite --port 5173",
    "dev:electron": "wait-on http://localhost:5173 && electron . --no-sandbox",
    "build:renderer": "cd renderer && npx vite build",
    "build": "npm run build:renderer && electron-builder",
    "start": "electron . --no-sandbox",
    "check": "cd renderer && npx svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^3.12.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.10.30",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.talamolm.electron",
    "productName": "TalamoLM",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../models",
        "to": "models",
        "filter": ["**/*"]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.icns"
    }
  }
}
